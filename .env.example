# Mirage environment variables — example file, NO REAL SECRETS.
#
# Copy to .env (gitignored) for local development. .env is only consulted
# when the active config's *_source fields are "env" (i.e. environment:
# development — see config/schema.json). Acceptance and production configs
# require credentials_source: secrets_manager and read nothing from .env;
# mirage-api/worker/etc. resolve those via IAM role + AWS Secrets Manager at
# startup (see docs/runbooks/secrets.md).
#
# scripts/validate-config --scan-secrets refuses to let a real-looking secret
# (anything not matching the *_dev_* / *_local_* placeholder convention below)
# be committed under this filename.

# --- Which config file to load ---
MIRAGE_ENV=development
MIRAGE_CONFIG_PATH=config/development.yaml

# --- PostgreSQL (local Docker Compose only) ---
MIRAGE_POSTGRES_USER=mirage_dev
MIRAGE_POSTGRES_PASSWORD=mirage_dev_local_only
MIRAGE_POSTGRES_DB=mirage

# --- NATS JetStream (local Docker Compose only) ---
MIRAGE_NATS_USER=mirage_dev
MIRAGE_NATS_PASSWORD=mirage_dev_local_only

# --- Elasticsearch (local Docker Compose only) ---
MIRAGE_ELASTIC_USER=elastic
MIRAGE_ELASTIC_PASSWORD=mirage_dev_local_only

# --- Keycloak bootstrap admin (local Docker Compose only) ---
MIRAGE_KEYCLOAK_ADMIN_USER=admin
MIRAGE_KEYCLOAK_ADMIN_PASSWORD=mirage_dev_local_only

# --- step-ca bootstrap (local Docker Compose only) ---
MIRAGE_STEP_CA_PASSWORD=mirage_dev_local_only
# Root CA fingerprint is generated at `scripts/bootstrap-development` time and
# written here by the script itself — left blank in the example.
MIRAGE_STEP_CA_ROOT_FINGERPRINT=

# --- mTLS proxy shared secret (Task #17, ADR-0024) ---
# The bearer secret Nginx's mTLS-terminating listener presents alongside the
# verified client certificate serial (mtls_auth.py's X-Mirage-Proxy-Auth
# header contract, Step 4/8a) — proves a request reached mirage-api /
# mirage-agent-ingestion / mirage-sandbox-gateway THROUGH Nginx, not directly.
# Every service sharing this value must agree on it; dev-local placeholder
# only, never valid outside this compose network.
MIRAGE_PROXY_SHARED_SECRET=mirage_dev_local_only_proxy_secret

# --- Fleet Server enrollment token (local Docker Compose only) ---
MIRAGE_FLEET_ENROLLMENT_TOKEN=

# --- Dev sandbox target SSH public key (Step 7b, docker-compose.dev-sandbox.yml).
#     Generated by `scripts/bootstrap-dev-sandbox-keys`, which prints the exact
#     line to paste here — left blank in the example. ---
MIRAGE_DEV_SANDBOX_SSH_PUBLIC_KEY=

# --- AI provider (development may point at a real provider for local testing;
#     NEVER commit a real key — export it in your shell instead of writing it
#     into a committed .env) ---
MIRAGE_AI_PROVIDER=openai
MIRAGE_AI_MODEL=REPLACE_ME_MODEL_NAME
MIRAGE_AI_BASE_URL=https://api.openai.com/v1
MIRAGE_AI_API_KEY=

# --- AWS (development does not call AWS; leave unset unless testing
#     scripts/doctor's AWS-credential detection) ---
AWS_PROFILE=
AWS_REGION=us-east-1

# --- Local MinIO only (S3-compatible integration tests; never production) ---
MIRAGE_MINIO_ACCESS_KEY=mirage_dev_minio
MIRAGE_MINIO_SECRET_KEY=mirage_dev_local_only_minio

# --- Stage 5 evidence storage ---
MIRAGE_EVIDENCE_BUCKET=mirage-evidence
MIRAGE_EVIDENCE_REGION=us-east-1
MIRAGE_EVIDENCE_ENDPOINT_URL=http://localhost:9002
MIRAGE_EVIDENCE_OBJECT_LOCK_MODE=GOVERNANCE
MIRAGE_EVIDENCE_RETENTION_DAYS=7
MIRAGE_EVIDENCE_MULTIPART_THRESHOLD_MB=8
MIRAGE_EVIDENCE_MAX_RETRIES=3
MIRAGE_EVIDENCE_REQUEST_TIMEOUT_SECONDS=10
MIRAGE_KMS_SIGNING_KEY_ARN=LOCAL_DEV_NO_KMS
MIRAGE_CANARY_INGESTION_HMAC=mirage_dev_local_only_canary
MIRAGE_EXPORT_SIGNER=LOCAL_DEVELOPMENT
MIRAGE_SESSION_SECRET=mirage_dev_dashboard_session_secret_change_me
# MIRAGE_RFC3161_AUTHORITY_URL and MIRAGE_RFC3161_CA_FILE are intentionally
# unset locally; local timestamps are labelled NOT independently trusted.

# --- Stage 6 AI (disabled externally by default) ---
AI_PROVIDER_SECRET_ARN=mirage/development/ai-provider
AI_TIMEOUT_SECONDS=10
AI_MAX_CONCURRENT_REQUESTS=4
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=1000
AI_DAILY_BUDGET_GBP=10
AI_MONTHLY_BUDGET_GBP=100
AI_MAX_RETRIES=2
AI_RETRY_BASE_SECONDS=0.25
AI_CIRCUIT_BREAKER_FAILURES=3
AI_CIRCUIT_BREAKER_RESET_SECONDS=60
AI_USAGE_ALERT_PERCENT=80
AI_ALLOW_EXTERNAL_PROVIDER=false
AI_MODEL_ALLOWLIST=deterministic-fake
AI_MAX_REQUESTS_PER_CASE=100

# --- Stage 7 artifact scanner ---
ARTIFACT_MAX_UPLOAD_MB=250
ARTIFACT_MAX_ARCHIVE_DEPTH=3
ARTIFACT_MAX_ARCHIVE_MEMBERS=1000
ARTIFACT_MAX_EXPANDED_MB=500
ARTIFACT_MAX_COMPRESSION_RATIO=100
ARTIFACT_MAX_MEMBER_MB=250
ARTIFACT_SCAN_TIMEOUT_SECONDS=120
ARTIFACT_CLAMAV_TIMEOUT_SECONDS=60
ARTIFACT_YARA_TIMEOUT_SECONDS=30
ARTIFACT_OLETOOLS_TIMEOUT_SECONDS=30
ARTIFACT_YARA_RULES_PATH=/app/config/yara/mirage-base-v1.yar

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
