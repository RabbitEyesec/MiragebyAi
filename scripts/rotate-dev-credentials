#!/usr/bin/env python3
"""Rotate every local development credential to fresh per-machine randomness.

Why this exists
---------------
`.env.example` is a public template, so the literals in it —
`mirage_dev_local_only` and friends — are published values. Bootstrapping by
copying that file verbatim (what `scripts/bootstrap-development` used to do)
gave every clone on every machine the *same* Postgres password, Keycloak admin
password, step-ca password, MinIO secret key, proxy shared secret and dashboard
session secret. Those are local-only services bound to 127.0.0.1, but a shared
published credential is still a credential nobody should inherit by default.

This script writes a real `.env` (gitignored) in which every secret-bearing
variable carries a value generated by `secrets.token_urlsafe` on this machine,
and discards the on-disk key material so the next bootstrap re-mints it.
Non-secret settings — ports, URLs, timeouts, budgets, bucket names — are copied
through from the template unchanged.

Values are never printed. Only names, and whether each was rotated.

Usage
-----
    scripts/rotate-dev-credentials            # rotate .env + discard key material
    scripts/rotate-dev-credentials --check    # exit 1 if any published literal remains
    scripts/rotate-dev-credentials --keep-keys  # rotate .env only
"""
from __future__ import annotations

import argparse
import secrets
import shutil
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
ENV_FILE = REPO_ROOT / ".env"
ENV_EXAMPLE = REPO_ROOT / ".env.example"

# Every variable whose value is a credential. Anything not listed here is
# copied from the template verbatim, so adding a new non-secret setting to
# .env.example needs no change in this file — but adding a new *secret* does,
# and --check is what catches that omission.
SECRET_VARS = {
    "MIRAGE_POSTGRES_PASSWORD",
    "MIRAGE_NATS_PASSWORD",
    "MIRAGE_ELASTIC_PASSWORD",
    "MIRAGE_KEYCLOAK_ADMIN_PASSWORD",
    "MIRAGE_STEP_CA_PASSWORD",
    "MIRAGE_PROXY_SHARED_SECRET",
    "MIRAGE_MINIO_SECRET_KEY",
    "MIRAGE_CANARY_INGESTION_HMAC",
    "MIRAGE_SESSION_SECRET",
}

# Substrings that mark a value as a published placeholder rather than a real
# per-machine secret. Only ever tested against SECRET_VARS: non-secret settings
# are entitled to a placeholder (MIRAGE_AI_MODEL ships as REPLACE_ME_MODEL_NAME
# because the operator must choose a model, and that is not a credential).
PUBLISHED_LITERALS = ("mirage_dev_local_only", "change_me", "REPLACE_ME")

# Regenerated on the next bootstrap / test run rather than rotated in place:
# these hold minted key material, not passwords, and the tools that create
# them are already idempotent.
KEY_MATERIAL_DIRS = (
    REPO_ROOT / ".dev-auth-keys",
    REPO_ROOT / ".broker-keys",
    REPO_ROOT / ".dev-sandbox-keys",
    REPO_ROOT / "infra" / "step-ca" / "dev-provisioner-keys",
)


def _new_secret() -> str:
    return secrets.token_urlsafe(32)


def render_env(template: str) -> tuple[str, list[str]]:
    """Return (env file contents, names rotated). Comments and ordering are
    preserved so the result stays diffable against the template."""
    rotated: list[str] = []
    lines: list[str] = []
    for line in template.splitlines():
        stripped = line.strip()
        if stripped.startswith("#") or "=" not in stripped:
            lines.append(line)
            continue
        name = stripped.split("=", 1)[0]
        if name in SECRET_VARS:
            lines.append(f"{name}={_new_secret()}")
            rotated.append(name)
        else:
            lines.append(line)
    return "\n".join(lines) + "\n", rotated


# Services that bake a credential into their data directory the first time they
# initialise, and ignore the environment variable on every later boot.
STATEFUL_VOLUMES = {
    "mirage-dev_mirage-postgres-data": "Postgres role password (POSTGRES_PASSWORD)",
    "mirage-dev_mirage-keycloak-data": "Keycloak bootstrap admin password",
    "mirage-dev_mirage-minio-data": "MinIO root credentials",
    "mirage-dev_mirage-stepca-data": "step-ca init password",
}


def warn_about_stateful_volumes() -> None:
    """Rotating a password does NOT change one already baked into a volume.

    Postgres, Keycloak, MinIO and step-ca each read their credential from the
    environment only on FIRST initialisation and store it in their data
    directory thereafter. Against a pre-existing volume, a rotated `.env` is
    simply wrong: every service then fails to authenticate. Observed exactly
    this — `psycopg.OperationalError: password authentication failed for user
    "mirage_dev"` crash-looping four containers, and a 401 from Keycloak's
    admin API — with volumes that predated the rotation.

    CI never sees it (fresh volumes every run), which is precisely why it is
    worth saying out loud here rather than leaving it to be rediscovered.
    """
    try:
        existing = subprocess.run(
            ["docker", "volume", "ls", "--format", "{{.Name}}"],
            capture_output=True, text=True, timeout=15, check=False,
        ).stdout.split()
    except (OSError, subprocess.SubprocessError):
        return

    stale = [name for name in existing if name in STATEFUL_VOLUMES]
    if not stale:
        return

    print("\nWARNING: these volumes still hold the PREVIOUS credentials:")
    for name in sorted(stale):
        print(f"  {name}  ({STATEFUL_VOLUMES[name]})")
    print(
        "\nThey were initialised with the old values and ignore the environment on\n"
        "restart, so the rotated .env will NOT authenticate against them. Recreate\n"
        "them (destroys local dev data only — never run this against anything you\n"
        "care about):\n"
        "\n  docker compose --env-file .env -f infra/compose/docker-compose.development.yml down\n"
        f"  docker volume rm {' '.join(sorted(stale))}\n"
        "\nOr keep the old data and revert .env to the values those volumes expect."
    )


def check() -> int:
    if not ENV_FILE.is_file():
        print("no .env present — nothing to check")
        return 0
    offenders = []
    for number, line in enumerate(ENV_FILE.read_text().splitlines(), start=1):
        if line.lstrip().startswith("#") or "=" not in line:
            continue
        name, _, value = line.partition("=")
        if name.strip() not in SECRET_VARS:
            continue
        if any(literal in value for literal in PUBLISHED_LITERALS):
            offenders.append(f"  .env:{number}: {name.strip()} still holds a published placeholder")
    if offenders:
        print(".env contains credentials copied from the public template:", file=sys.stderr)
        print("\n".join(offenders), file=sys.stderr)
        print("\nRun: scripts/rotate-dev-credentials", file=sys.stderr)
        return 1
    print(f".env clean — no published placeholder values ({len(SECRET_VARS)} secret variables checked)")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="report, do not modify")
    parser.add_argument("--keep-keys", action="store_true", help="rotate .env but keep on-disk key material")
    args = parser.parse_args()

    if args.check:
        return check()

    if not ENV_EXAMPLE.is_file():
        print(".env.example missing — cannot rotate", file=sys.stderr)
        return 1

    contents, rotated = render_env(ENV_EXAMPLE.read_text())
    ENV_FILE.write_text(contents)
    ENV_FILE.chmod(0o600)

    print(f"wrote {ENV_FILE.relative_to(REPO_ROOT)} (0600, gitignored)")
    for name in rotated:
        print(f"  rotated  {name}")

    if not args.keep_keys:
        for directory in KEY_MATERIAL_DIRS:
            if directory.exists():
                shutil.rmtree(directory)
                print(f"  discarded {directory.relative_to(REPO_ROOT)}/ (re-minted on next bootstrap)")

    warn_about_stateful_volumes()

    print(
        "\nNext: scripts/bootstrap-development, then "
        "scripts/bootstrap-step-ca-provisioners and scripts/bootstrap-keycloak-realm "
        "to re-mint key material against the rotated passwords."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
