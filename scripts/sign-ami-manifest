#!/usr/bin/env python3
"""Step 9a's final two pipeline stages, run AFTER `packer build` completes
(the build instance is already terminated by then — see
employee-sandbox.pkr.hcl's own comment on why this can't be a Packer
provisioner): "KMS-sign manifest -> tag AMI with manifest hash."

Builds a manifest (AMI ID, build version, git commit, fingerprint report,
SBOM hash), signs it with a real AWS KMS asymmetric signing key, and tags
the resulting AMI with the manifest's own SHA-256 — "Terraform consumes
only approved AMI IDs" (this script IS the approval act; an AMI this
script never signs has no manifest and Terraform's own AMI ID variable
should never point at it).

LAB_VERIFICATION_REQUIRED: needs a real AWS account (KMS key + EC2
permissions). Structurally real boto3 code, reviewed, not executable here
— same documented-stub pattern as Step 3's Secrets Manager loader
(ARCHITECTURE_DECISIONS.md).
"""
from __future__ import annotations

import argparse
import base64
import hashlib
import json
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
PACKER_DIR = REPO_ROOT / "infra" / "packer"


def _git_commit() -> str:
    result = subprocess.run(["git", "rev-parse", "HEAD"], cwd=REPO_ROOT, capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else "unknown"


def _load_json_or_none(path: Path) -> dict | None:
    return json.loads(path.read_text()) if path.exists() else None


def build_manifest(*, build_version: str, environment: str) -> dict:
    packer_manifest_path = PACKER_DIR / "manifest.packer.json"
    if not packer_manifest_path.exists():
        raise FileNotFoundError(
            f"{packer_manifest_path} not found — run `packer build` first (LAB_VERIFICATION_REQUIRED, real AWS account)."
        )
    packer_manifest = json.loads(packer_manifest_path.read_text())
    last_run = packer_manifest["builds"][-1]
    ami_id = last_run["artifact_id"].split(":")[-1]

    fingerprint_report = _load_json_or_none(PACKER_DIR / "build-artifacts" / "fingerprint-report.json")
    sbom = _load_json_or_none(PACKER_DIR / "build-artifacts" / "sbom.json")

    if fingerprint_report is None:
        raise RuntimeError("no fingerprint-report.json in build-artifacts/ — refusing to sign an unverified image.")
    if not fingerprint_report["passed"]:
        raise RuntimeError("fingerprint report shows a FAILED check — refusing to sign (§6.5: 'inconsistent sandbox is worse than none').")

    sbom_sha256 = hashlib.sha256(json.dumps(sbom, sort_keys=True).encode()).hexdigest() if sbom else None

    return {
        "ami_id": ami_id,
        "build_version": build_version,
        "environment": environment,
        "git_commit": _git_commit(),
        "built_at": datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z",
        "fingerprint_report_summary": {
            "target_id": fingerprint_report["target_id"],
            "baseline_version": fingerprint_report["baseline_version"],
            "passed": fingerprint_report["passed"],
            "all_must_passed": fingerprint_report["all_must_passed"],
            "should_pass_ratio": fingerprint_report["should_pass_ratio"],
        },
        "sbom_sha256": sbom_sha256,
    }


def sign_manifest_with_kms(manifest: dict, *, kms_key_arn: str) -> dict:
    """Real boto3 KMS asymmetric signing — RSASSA_PKCS1_V1_5_SHA_256, the
    same signing scheme used elsewhere for evidence-grade manifests
    (Appendix per Step 11's evidence export, not yet built in this
    prompt — this function anticipates that same contract rather than
    inventing a one-off scheme Step 11 would have to reconcile later)."""
    import boto3  # noqa: PLC0415 -- only imported when actually signing (LAB path)

    kms = boto3.client("kms")
    canonical_bytes = json.dumps(manifest, sort_keys=True, separators=(",", ":")).encode("utf-8")
    response = kms.sign(
        KeyId=kms_key_arn, Message=canonical_bytes, MessageType="RAW", SigningAlgorithm="RSASSA_PKCS1_V1_5_SHA_256",
    )
    signature_b64 = base64.b64encode(response["Signature"]).decode()
    manifest_hash = hashlib.sha256(canonical_bytes).hexdigest()
    return {
        **manifest,
        "manifest_sha256": manifest_hash,
        "kms_key_arn": kms_key_arn,
        "kms_signing_algorithm": "RSASSA_PKCS1_V1_5_SHA_256",
        "signature_base64": signature_b64,
    }


def tag_ami_with_manifest_hash(*, ami_id: str, manifest_sha256: str, region: str) -> None:
    import boto3  # noqa: PLC0415

    ec2 = boto3.client("ec2", region_name=region)
    ec2.create_tags(Resources=[ami_id], Tags=[{"Key": "ManifestSha256", "Value": manifest_sha256}])


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--build-version", required=True)
    parser.add_argument("--environment", required=True, choices=["development", "acceptance"])
    parser.add_argument("--kms-key-arn", required=True)
    parser.add_argument("--region", default="us-east-1")
    parser.add_argument("--dry-run", action="store_true", help="build + print the manifest but do not call KMS/EC2 (safe without AWS credentials)")
    args = parser.parse_args()

    manifest = build_manifest(build_version=args.build_version, environment=args.environment)

    if args.dry_run:
        print(json.dumps(manifest, indent=2))
        print("\n--dry-run: not signing or tagging (no AWS calls made).", file=sys.stderr)
        return 0

    signed = sign_manifest_with_kms(manifest, kms_key_arn=args.kms_key_arn)
    tag_ami_with_manifest_hash(ami_id=signed["ami_id"], manifest_sha256=signed["manifest_sha256"], region=args.region)

    out_path = PACKER_DIR / f"signed-manifest-{signed['ami_id']}.json"
    out_path.write_text(json.dumps(signed, indent=2))
    print(f"Signed manifest written to {out_path}; AMI {signed['ami_id']} tagged with ManifestSha256={signed['manifest_sha256']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
