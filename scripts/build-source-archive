#!/usr/bin/env python3
"""Builds a clean, public-safe source archive of this repository.

Uses `git archive`, which by construction includes ONLY committed,
git-tracked files at the given ref — no `.git/` history metadata beyond
what a commit itself carries, no untracked working-tree files, no
gitignored directories (`node_modules/`, `.venv/`, `.next/`,
`.dev-auth-keys/`, `infra/step-ca/dev-provisioner-keys/`, etc.). That
alone is not sufficient proof the archive is safe to publish — a secret
could have been committed and tracked despite `.gitignore`'s intent — so
this refuses to build anything until `scripts/audit-public-repository`
passes for the exact ref being archived. Fail-closed by construction, the
same pattern `scripts/verify-release`/`scripts/validate-production-compose`
already use elsewhere in this codebase.

P0 (repo/secret hygiene mechanics) remediation — see KNOWN_ISSUES.md.
"""
from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent


def _git(args: list[str]) -> str:
    result = subprocess.run(["git", "-C", str(REPO_ROOT), *args], capture_output=True, text=True, check=True)
    return result.stdout.strip()


def build_archive(ref: str, output: Path) -> None:
    output.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(
        ["git", "-C", str(REPO_ROOT), "archive", "--format=tar.gz", f"--output={output}", ref],
        check=True,
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--ref", default="HEAD", help="git ref to archive (default: HEAD)")
    parser.add_argument("--output", type=Path, required=True, help="output .tar.gz path")
    parser.add_argument(
        "--skip-audit",
        action="store_true",
        help="DANGEROUS: skip scripts/audit-public-repository before archiving. Never use this for an "
        "artifact that will actually be published — only for a local, throwaway inspection copy.",
    )
    args = parser.parse_args()

    if args.ref != "HEAD":
        current = _git(["rev-parse", "HEAD"])
        target = _git(["rev-parse", args.ref])
        if current != target:
            print(
                f"refusing to archive {args.ref!r}: it does not match the currently checked-out HEAD "
                f"({current[:12]} vs {target[:12]}) — scripts/audit-public-repository audits the working "
                "tree/tracked-file state, not an arbitrary historical ref; check out the ref you want "
                "audited-and-archived first.",
                file=sys.stderr,
            )
            return 2

    if args.skip_audit:
        print("WARNING: --skip-audit set — building WITHOUT the public-repository audit. Do not publish this archive.")
    else:
        audit = subprocess.run([sys.executable, str(REPO_ROOT / "scripts" / "audit-public-repository")])
        if audit.returncode != 0:
            print("Refusing to build source archive: scripts/audit-public-repository failed. Fix the findings above first.")
            return 1

    build_archive(args.ref, args.output)
    print(f"Source archive written to {args.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
