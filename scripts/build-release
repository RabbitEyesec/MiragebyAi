#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path

from mirage_common.release import build_release

parser = argparse.ArgumentParser(description="Build a signed Mirage release bundle.")
parser.add_argument("--version", required=True)
parser.add_argument("--output", type=Path, required=True)
parser.add_argument("--signing-key", type=Path, required=True)
parser.add_argument("--endpoint-package", type=Path)
parser.add_argument("--sandbox-package", type=Path)
args = parser.parse_args()
print(
    json.dumps(
        build_release(
            Path.cwd(),
            version=args.version,
            output=args.output,
            signing_key=args.signing_key,
            endpoint_package=args.endpoint_package,
            sandbox_package=args.sandbox_package,
        ),
        indent=2,
        sort_keys=True,
    )
)
