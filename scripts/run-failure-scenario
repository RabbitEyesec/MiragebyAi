#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path

from mirage_common.resilience import (
    run_local_scenario,
    run_profile_b_scenario,
    scenario,
)

parser = argparse.ArgumentParser(description="Run or plan a Mirage fault-injection scenario.")
parser.add_argument("test_id")
parser.add_argument("--profile-b", action="store_true")
parser.add_argument("--recipe", type=Path)
parser.add_argument("--confirm")
args = parser.parse_args()
definition = scenario(args.test_id)
if args.profile_b:
    if args.recipe is None:
        parser.error("--profile-b requires --recipe")
    result = run_profile_b_scenario(
        args.test_id,
        recipe_path=args.recipe,
        confirmation=args.confirm or "",
    )
    print(json.dumps(result, indent=2, sort_keys=True))
    raise SystemExit(0 if result["result"] == "PASS" else 1)
result = run_local_scenario(args.test_id)
print(json.dumps(result, indent=2, sort_keys=True))
raise SystemExit(0 if result["result"] in {"PASS", "NOT_RUN"} else 1)
