#!/usr/bin/env python3
"""Idempotently apply Mirage's Elasticsearch ILM policy, component
templates, and index templates (Step 4, Appendix E) to a running
Elasticsearch cluster. Called by scripts/bootstrap-development; safe to
re-run.
"""
from __future__ import annotations

import os
from pathlib import Path

import httpx

REPO_ROOT = Path(__file__).resolve().parent.parent
ELASTIC_DIR = REPO_ROOT / "infra" / "elastic"


def main() -> int:
    base_url = os.environ.get("MIRAGE_ELASTIC_URL", "http://localhost:9200")
    headers = {"Content-Type": "application/json", "Accept": "application/json"}
    with httpx.Client(base_url=base_url, timeout=10.0, headers=headers) as client:
        for ilm_file in sorted((ELASTIC_DIR / "ilm").glob("*.json")):
            name = ilm_file.stem
            resp = client.put(f"/_ilm/policy/{name}", content=ilm_file.read_text())
            resp.raise_for_status()
            print(f"ILM policy: {name} -> {resp.json()}")

        for pipeline_file in sorted((ELASTIC_DIR / "ingest_pipelines").glob("*.json")):
            name = pipeline_file.stem
            resp = client.put(f"/_ingest/pipeline/{name}", content=pipeline_file.read_text())
            resp.raise_for_status()
            print(f"Ingest pipeline: {name} -> {resp.json()}")

        for ct_file in sorted((ELASTIC_DIR / "component_templates").glob("*.json")):
            name = ct_file.stem
            resp = client.put(f"/_component_template/{name}", content=ct_file.read_text())
            resp.raise_for_status()
            print(f"Component template: {name} -> {resp.json()}")

        for it_file in sorted((ELASTIC_DIR / "index_templates").glob("*.json")):
            name = it_file.stem
            resp = client.put(f"/_index_template/{name}", content=it_file.read_text())
            resp.raise_for_status()
            print(f"Index template: {name} -> {resp.json()}")

    print("Elastic templates provisioned.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
