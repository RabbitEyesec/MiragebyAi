#!/usr/bin/env python3
"""Audits whether this repository is safe to publish/mirror publicly.

`.gitignore` already excludes `.env`, `*.pem`/`*.key`, `node_modules/`,
`.next/`, `infra/step-ca/dev-provisioner-keys/`, `.dev-auth-keys/`, etc. —
but a `.gitignore` rule only prevents FUTURE accidental adds; it proves
nothing about whether one of those ever got committed before the rule
existed, or via `git add -f`. This script checks the actual git-tracked
file list and git HISTORY (not just the working tree, and not just
`.gitignore`'s intent) for exactly that: real private-key material, real
env files, real vendored dependency trees, and any secret-shaped value
`scripts/validate-config --scan-secrets` and `gitleaks` (an independent,
differently-implemented detection engine — real defense in depth, not the
same check run twice) can find. Fails closed: any finding is a non-zero
exit, no partial/soft-pass mode.

P0 (repo/secret hygiene mechanics) remediation — see KNOWN_ISSUES.md.
"""
from __future__ import annotations

import argparse
import re
import shutil
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent

# Directories that must never appear as git-tracked paths — vendored/
# generated trees that belong only in .gitignore, never in git history.
FORBIDDEN_TRACKED_PATH_PATTERNS = (
    re.compile(r"(^|/)node_modules/"),
    re.compile(r"(^|/)\.next/"),
    re.compile(r"(^|/)\.next-e2e-fixture/"),
    re.compile(r"(^|/)__pycache__/"),
    re.compile(r"(^|/)\.venv/"),
    re.compile(r"(^|/)dev-provisioner-keys/"),
    re.compile(r"(^|/)\.dev-auth-keys/"),
)

# Exact tracked paths that must never exist — real env files, never examples.
FORBIDDEN_TRACKED_EXACT_NAMES = {".env", "dashboard/.env.local"}

PRIVATE_KEY_MARKERS = (
    b"-----BEGIN RSA PRIVATE KEY-----",  # secret-scan: ignore (detection signature, not key material) gitleaks:allow
    b"-----BEGIN EC PRIVATE KEY-----",  # secret-scan: ignore (detection signature, not key material) gitleaks:allow
    b"-----BEGIN PRIVATE KEY-----",  # secret-scan: ignore (detection signature, not key material) gitleaks:allow
    b"-----BEGIN OPENSSH PRIVATE KEY-----",  # secret-scan: ignore (detection signature, not key material) gitleaks:allow
    b"-----BEGIN ENCRYPTED PRIVATE KEY-----",  # secret-scan: ignore (detection signature, not key material) gitleaks:allow
)


def _git_tracked_files() -> list[str]:
    result = subprocess.run(
        ["git", "-C", str(REPO_ROOT), "ls-files"],
        capture_output=True,
        text=True,
        check=True,
    )
    return [line for line in result.stdout.splitlines() if line]


def check_forbidden_tracked_paths(tracked: list[str]) -> list[str]:
    problems = []
    for rel in tracked:
        if rel in FORBIDDEN_TRACKED_EXACT_NAMES:
            problems.append(f"{rel}: a real env file is git-tracked")
        for pattern in FORBIDDEN_TRACKED_PATH_PATTERNS:
            if pattern.search(rel):
                problems.append(f"{rel}: matches a forbidden vendored/generated/secret-key path pattern")
                break
    return problems


def check_no_private_key_content(tracked: list[str]) -> list[str]:
    """Content-based, not filename-based — a *.pem file could legitimately
    be a PUBLIC key (e.g. public-keys/release-signing.pem, bundled into
    every release on purpose); only the actual PEM private-key header is a
    real finding."""
    problems = []
    self_path = Path(__file__).resolve().relative_to(REPO_ROOT).as_posix()
    for rel in tracked:
        if rel == self_path:
            # This file's own PRIVATE_KEY_MARKERS tuple legitimately embeds
            # every marker string as a detection signature, not key
            # material — scanning it against itself is a guaranteed
            # self-match, not a real finding.
            continue
        path = REPO_ROOT / rel
        if not path.is_file():
            continue
        try:
            head = path.read_bytes()[:4096]
        except OSError:
            continue
        for marker in PRIVATE_KEY_MARKERS:
            if marker in head:
                problems.append(f"{rel}: contains a {marker.decode()} header")
                break
    return problems


def check_custom_secret_scan() -> list[str]:
    result = subprocess.run(
        [sys.executable, str(REPO_ROOT / "scripts" / "validate-config"), "--scan-secrets"],
        capture_output=True,
        text=True,
        cwd=REPO_ROOT,
    )
    if result.returncode != 0:
        return [f"scripts/validate-config --scan-secrets failed:\n{result.stdout}{result.stderr}"]
    return []


def check_gitleaks() -> list[str]:
    """A second, independently-implemented secret scanner (entropy +
    provider-specific regex rules) run against git HISTORY, not just the
    working tree — catches a secret that was committed and later removed,
    which a working-tree-only check can never see. Skipped (not silently
    passed) with a clear reason if the binary isn't installed — this
    repo doesn't vendor gitleaks itself, same as it doesn't vendor
    terraform/packer/tfsec."""
    binary = shutil.which("gitleaks")
    if binary is None:
        return ["SKIPPED: gitleaks binary not found on PATH — install it to get this check for real (https://github.com/gitleaks/gitleaks)"]
    result = subprocess.run(
        [binary, "detect", "--source", str(REPO_ROOT), "--redact", "--exit-code", "1"],
        capture_output=True,
        text=True,
        cwd=REPO_ROOT,
    )
    if result.returncode not in (0, 1):
        return [f"gitleaks itself failed to run (exit {result.returncode}):\n{result.stderr}"]
    if result.returncode == 1:
        return [f"gitleaks found potential secrets in git history:\n{result.stdout}"]
    return []


def run_audit() -> list[str]:
    tracked = _git_tracked_files()
    problems: list[str] = []
    problems += check_forbidden_tracked_paths(tracked)
    problems += check_no_private_key_content(tracked)
    problems += check_custom_secret_scan()
    problems += check_gitleaks()
    return problems


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.parse_args()

    problems = run_audit()
    hard_failures = [p for p in problems if not p.startswith("SKIPPED:")]
    skipped = [p for p in problems if p.startswith("SKIPPED:")]

    for p in skipped:
        print(f"WARNING: {p}")

    if hard_failures:
        print(f"Public-repository audit FAILED ({len(hard_failures)} problem(s)):")
        for p in hard_failures:
            print(f"  - {p}")
        return 1

    print("Public-repository audit OK — no tracked secrets, private keys, or forbidden vendored paths found.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
