#!/usr/bin/env python3
"""Plan or execute acceptance teardown with evidence retention and inventory proof."""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--profile", choices=("local", "profile-a", "profile-b"), required=True)
    parser.add_argument("--execute", action="store_true")
    parser.add_argument("--confirm")
    parser.add_argument("--region", default="us-east-1")
    args = parser.parse_args()
    if args.profile == "local":
        commands = [["docker", "compose", "--env-file", ".env", "-f", "infra/compose/docker-compose.development.yml", "down", "--remove-orphans"]]
    else:
        environment = "acceptance" if args.profile == "profile-b" else "dev"
        directory = ROOT / "infra" / "terraform" / "environments" / environment
        commands = [
            ["terraform", f"-chdir={directory}", "destroy", "-var-file=terraform.tfvars"],
            [
                sys.executable,
                str(ROOT / "scripts" / "verify-teardown"),
                "--environment",
                environment,
                "--region",
                args.region,
                "--allow-evidence-bucket",
            ],
        ]
    print(json.dumps({"profile": args.profile, "commands": commands, "execute": args.execute}, indent=2))
    if not args.execute:
        return 0
    confirmation = f"TEARDOWN {args.profile}"
    if args.confirm != confirmation:
        parser.error(f"--confirm must equal {confirmation!r}")
    for command in commands:
        result = subprocess.run(command, cwd=ROOT, check=False)
        if result.returncode:
            return result.returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
