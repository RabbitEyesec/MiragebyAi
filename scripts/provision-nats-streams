#!/usr/bin/env python3
"""Idempotently provision the six MIRAGE_* JetStream streams (Step 1b,
Appendix D) against a running NATS server. Called by
scripts/bootstrap-development; safe to run repeatedly.
"""
from __future__ import annotations

import asyncio
import os
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT / "libs"))

from mirage_common.nats_client import connect, ensure_streams  # noqa: E402
from mirage_common.subjects import STREAM_DEFINITIONS  # noqa: E402


async def main() -> int:
    servers = os.environ.get("MIRAGE_NATS_URL", "nats://localhost:4222")
    print(f"Connecting to {servers} ...")
    nc, js = await connect(servers)
    try:
        touched = await ensure_streams(js)
        for name in touched:
            info = await js.stream_info(name)
            defn = STREAM_DEFINITIONS[name]
            print(f"  {name}: subjects={defn.subjects} max_age={defn.max_age_seconds}s messages={info.state.messages}")
        print(f"Provisioned {len(touched)}/6 streams.")
        return 0
    finally:
        await nc.close()


if __name__ == "__main__":
    raise SystemExit(asyncio.run(main()))
