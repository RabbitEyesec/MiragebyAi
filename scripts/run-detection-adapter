#!/usr/bin/env python3
"""Runs mirage-worker's detection-into-cases adapter (Step 7) against the
real dev stack. Ctrl-C to stop cleanly.
"""
from __future__ import annotations

import asyncio
import os
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT / "libs"))
sys.path.insert(0, str(REPO_ROOT / "services" / "mirage-worker"))

import psycopg  # noqa: E402
from mirage_worker.detection_adapter import (  # noqa: E402
    DETECTION_RAISED_SUBJECT,
    DURABLE_NAME,
    STREAM_NAME,
    DetectionAdapter,
)

from mirage_common.nats_client import DeadLetterAwareConsumer, connect  # noqa: E402


def pg_dsn_from_env() -> str:
    host = os.environ.get("MIRAGE_POSTGRES_HOST", "localhost")
    port = os.environ.get("MIRAGE_POSTGRES_PORT", "5432")
    user = os.environ.get("MIRAGE_POSTGRES_USER", "mirage_dev")
    password = os.environ.get("MIRAGE_POSTGRES_PASSWORD", "mirage_dev_local_only")
    db = os.environ.get("MIRAGE_POSTGRES_DB", "mirage")
    return f"host={host} port={port} user={user} password={password} dbname={db}"


async def main() -> int:
    nats_url = os.environ.get("MIRAGE_NATS_URL", "nats://localhost:4222")
    conn = await psycopg.AsyncConnection.connect(pg_dsn_from_env())
    nc, js = await connect(nats_url)
    consumer = DeadLetterAwareConsumer(
        js, stream=STREAM_NAME, durable_name=DURABLE_NAME, filter_subject=DETECTION_RAISED_SUBJECT,
    )
    await consumer.bind()
    adapter = DetectionAdapter(conn=conn, consumer=consumer)
    print(f"mirage-detection-adapter: consuming {DETECTION_RAISED_SUBJECT} from {nats_url} ...")
    try:
        while True:
            n = await adapter.run_batch()
            if n == 0:
                await asyncio.sleep(1.0)
    except KeyboardInterrupt:
        pass
    finally:
        await conn.close()
        await nc.close()
    return 0


if __name__ == "__main__":
    raise SystemExit(asyncio.run(main()))
