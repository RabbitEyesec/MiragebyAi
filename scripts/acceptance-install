#!/usr/bin/env python3
"""Plan or run server and signed Windows-package installation for acceptance."""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--profile", choices=("local", "profile-a", "profile-b"), required=True)
    parser.add_argument("--server-package", type=Path, required=True)
    parser.add_argument("--config", type=Path, required=True)
    parser.add_argument("--endpoint-msi", type=Path)
    parser.add_argument("--sandbox-msi", type=Path)
    parser.add_argument("--execute", action="store_true")
    parser.add_argument("--confirm")
    args = parser.parse_args()
    commands: list[list[str]] = [
        [
            sys.executable,
            str(ROOT / "scripts" / "verify-release"),
            str(args.server_package),
        ],
        [
            sys.executable,
            str(ROOT / "scripts" / "install-server"),
            "--environment",
            "acceptance" if args.profile == "profile-b" else "development",
            "--config",
            str(args.config),
            "--package",
            str(args.server_package),
            *(["--execute-internal"] if args.execute else ["--dry-run"]),
        ],
    ]
    if args.profile == "profile-b":
        if not args.endpoint_msi or not args.sandbox_msi:
            parser.error("Profile B requires --endpoint-msi and --sandbox-msi")
        endpoint_host = os.getenv("MIRAGE_ACCEPTANCE_ENDPOINT_HOST", "REQUIRED")
        sandbox_host = os.getenv("MIRAGE_ACCEPTANCE_SANDBOX_HOST", "REQUIRED")
        commands.extend(
            [
                ["pwsh", "-File", "installers/endpoint/scripts/test-install-lifecycle.ps1", "-ComputerName", endpoint_host, "-Msi", str(args.endpoint_msi)],
                ["pwsh", "-File", "installers/sandbox/test-clean-vm.ps1", "-ComputerName", sandbox_host, "-Msi", str(args.sandbox_msi)],
            ]
        )
    print(json.dumps({"profile": args.profile, "commands": commands, "execute": args.execute}, indent=2))
    if not args.execute:
        return 0
    confirmation = f"INSTALL {args.profile}"
    if args.confirm != confirmation:
        parser.error(f"--confirm must equal {confirmation!r}")
    for command in commands:
        result = subprocess.run(command, cwd=ROOT, check=False)
        if result.returncode:
            return result.returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
