{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirage.local/schemas/events/canary.callback.v1.schema.json",
  "title": "CanaryCallbackV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["callback_id", "token_id", "callback_time", "source_ip", "classification", "confidence", "rule_version", "signature"],
  "properties": {
    "callback_id": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "token_id": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "callback_time": {"type": "string", "format": "date-time"},
    "source_ip": {"type": "string", "minLength": 2, "maxLength": 64},
    "classification": {"enum": ["IN_SANDBOX_CALLBACK", "SECURITY_SCANNER_CALLBACK", "EXTERNAL_CALLBACK", "UNKNOWN_SOURCE_CALLBACK"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rule_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "signature": {"type": "string", "minLength": 32, "maxLength": 256}
  }
}
