{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mirage.local/api/dashboard_read_model.v1.schema.json",
  "title": "DashboardReadModelV1",
  "description": "Canonical Stage 9 read model shared by timelines, 2D/3D graphs, Evidence Board, and reports.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary", "timeline", "graph", "freshness"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "summary": { "$ref": "#/$defs/caseSummary" },
    "timeline": {
      "type": "array",
      "items": { "$ref": "#/$defs/timelineItem" }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "sampled", "total_nodes", "total_edges"],
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/graphNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/graphEdge" } },
        "sampled": { "type": "boolean" },
        "total_nodes": { "type": "integer", "minimum": 0 },
        "total_edges": { "type": "integer", "minimum": 0 }
      }
    },
    "freshness": { "$ref": "#/$defs/freshness" }
  },
  "$defs": {
    "outputTag": {
      "type": ["string", "null"],
      "enum": [
        "REAL_OS_OUTPUT",
        "DECOY_SERVICE_OUTPUT",
        "AI_GENERATED_INTERACTION",
        "ANALYST_MESSAGE",
        "UNTRUSTED_INTRUDER_OUTPUT",
        null
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "OBSERVED_FACT",
        "DETERMINISTIC_CORRELATION",
        "AI_INFERENCE",
        "ANALYST_ACTION",
        "SYSTEM_ACTION"
      ]
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id"],
      "properties": {
        "source_type": { "type": "string", "maxLength": 64 },
        "source_id": { "type": "string", "maxLength": 256 },
        "source_sequence": { "type": ["integer", "null"], "minimum": 0 },
        "event_id": { "type": ["string", "null"], "maxLength": 64 }
      }
    },
    "caseSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "state", "version", "severity", "active_session_count",
        "evidence_verified_count", "evidence_total_count",
        "unresolved_gap_count", "export_eligible", "projection_version"
      ],
      "properties": {
        "case_id": { "type": "string" },
        "state": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "severity": { "type": "string" },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "owner": { "type": ["string", "null"] },
        "active_session_count": { "type": "integer", "minimum": 0 },
        "evidence_verified_count": { "type": "integer", "minimum": 0 },
        "evidence_total_count": { "type": "integer", "minimum": 0 },
        "unresolved_gap_count": { "type": "integer", "minimum": 0 },
        "export_eligible": { "type": "boolean" },
        "projection_version": { "type": "integer", "minimum": 0 }
      }
    },
    "timelineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id", "item_type", "classification", "label", "description",
        "case_id", "event_time", "source_event_ids", "source_references",
        "evidence_references", "display_metadata", "permissions", "version"
      ],
      "properties": {
        "item_id": { "type": "string" },
        "item_type": { "type": "string" },
        "classification": { "$ref": "#/$defs/classification" },
        "label": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 2048 },
        "case_id": { "type": "string" },
        "session_id": { "type": ["string", "null"] },
        "event_time": { "type": "string", "format": "date-time" },
        "source_event_ids": { "type": "array", "items": { "type": "string" } },
        "source_references": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceReference" }
        },
        "evidence_references": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "output_tag": { "$ref": "#/$defs/outputTag" },
        "display_metadata": { "type": "object", "additionalProperties": true },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "graphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id", "node_type", "label", "case_id", "event_time",
        "source_event_ids", "source_references", "evidence_references",
        "classification", "display_metadata", "permissions", "version"
      ],
      "properties": {
        "node_id": { "type": "string" },
        "node_type": {
          "type": "string",
          "enum": [
            "CASE", "SESSION", "HOST", "USER", "PROCESS", "FILE", "DIRECTORY",
            "IP_ADDRESS", "NETWORK_CONNECTION", "ALERT", "DETECTION", "ARTIFACT",
            "CANARY_TOKEN", "CANARY_CALLBACK", "AI_SNAPSHOT", "AI_PROPOSAL",
            "POLICY_DECISION", "SANDBOX_ACTION", "ANALYST_DIRECTIVE",
            "ANALYST_MESSAGE", "EVIDENCE_OBJECT", "EXPORT", "CERTIFICATE", "AGENT"
          ]
        },
        "label": { "type": "string", "maxLength": 256 },
        "case_id": { "type": "string" },
        "session_id": { "type": ["string", "null"] },
        "event_time": { "type": "string", "format": "date-time" },
        "source_event_ids": { "type": "array", "items": { "type": "string" } },
        "source_references": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceReference" }
        },
        "evidence_references": { "type": "array", "items": { "type": "string" } },
        "classification": { "$ref": "#/$defs/classification" },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "output_tag": { "$ref": "#/$defs/outputTag" },
        "display_metadata": { "type": "object", "additionalProperties": true },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "graphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id", "edge_type", "label", "source_node_id", "target_node_id",
        "case_id", "event_time", "source_event_ids", "source_references",
        "evidence_references", "classification", "display_metadata",
        "permissions", "version"
      ],
      "properties": {
        "edge_id": { "type": "string" },
        "edge_type": {
          "type": "string",
          "enum": [
            "OBSERVED_ON", "SPAWNED", "READ", "WROTE", "CREATED", "MOVED",
            "CONNECTED_TO", "AUTHENTICATED_AS", "TRIGGERED", "CORRELATED_WITH",
            "SUPPORTED_BY", "PROPOSED", "ALLOWED_BY", "DENIED_BY", "EXECUTED_AS",
            "CAUSED", "DEPLOYED_TO", "CALLBACK_FOR", "DIRECTED", "MESSAGED",
            "PRESERVED_AS", "INCLUDED_IN", "SIGNED_BY", "BELONGS_TO"
          ]
        },
        "label": { "type": "string", "maxLength": 256 },
        "source_node_id": { "type": "string" },
        "target_node_id": { "type": "string" },
        "case_id": { "type": "string" },
        "session_id": { "type": ["string", "null"] },
        "event_time": { "type": "string", "format": "date-time" },
        "source_event_ids": { "type": "array", "items": { "type": "string" } },
        "source_references": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceReference" }
        },
        "evidence_references": { "type": "array", "items": { "type": "string" } },
        "classification": { "$ref": "#/$defs/classification" },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "output_tag": { "$ref": "#/$defs/outputTag" },
        "display_metadata": { "type": "object", "additionalProperties": true },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "projection_version", "projected_at", "gap_detected"],
      "properties": {
        "status": { "type": "string", "enum": ["CURRENT", "STALE", "GAP_DETECTED", "REBUILDING"] },
        "projection_version": { "type": "integer", "minimum": 0 },
        "projected_at": { "type": "string", "format": "date-time" },
        "last_event_time": { "type": ["string", "null"], "format": "date-time" },
        "gap_detected": { "type": "boolean" },
        "gap_from": { "type": ["integer", "null"], "minimum": 0 },
        "gap_to": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
