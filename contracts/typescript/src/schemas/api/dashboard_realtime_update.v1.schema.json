{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mirage.local/api/dashboard_realtime_update.v1.schema.json",
  "title": "DashboardRealtimeUpdateV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "update_id", "update_type", "case_id", "projection_version",
    "event_time", "payload", "correlation_id"
  ],
  "properties": {
    "update_id": { "type": "string" },
    "update_type": {
      "type": "string",
      "enum": [
        "CASE_UPDATED", "TIMELINE_APPENDED", "GRAPH_NODE_UPSERTED",
        "GRAPH_EDGE_UPSERTED", "EVIDENCE_UPDATED", "AI_STATE_UPDATED",
        "SANDBOX_STATE_UPDATED", "ARTIFACT_UPDATED", "CANARY_UPDATED",
        "DIRECTIVE_UPDATED", "MESSAGE_UPDATED", "EXPORT_UPDATED",
        "HEALTH_UPDATED", "NOTIFICATION_CREATED", "FULL_REFRESH_REQUIRED",
        "HEARTBEAT"
      ]
    },
    "case_id": { "type": ["string", "null"] },
    "projection_version": { "type": "integer", "minimum": 0 },
    "event_time": { "type": "string", "format": "date-time" },
    "payload": { "type": "object", "additionalProperties": true },
    "correlation_id": { "type": "string" }
  }
}
