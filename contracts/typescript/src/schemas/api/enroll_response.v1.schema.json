{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirage.internal/schemas/api/enroll_response.v1.schema.json",
  "title": "EnrollResponse",
  "description": "POST /api/v1/enroll response body (Appendix F, Step 3). Returns a short-lived certificate; never returns the CA private key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "certificate_pem", "certificate_chain_pem", "certificate_serial", "not_after"],
  "properties": {
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "certificate_pem": {"type": "string", "minLength": 32, "pattern": "^-----BEGIN CERTIFICATE-----"},
    "certificate_chain_pem": {"type": "string", "minLength": 32},
    "certificate_serial": {"type": "string", "minLength": 1, "maxLength": 128},
    "not_after": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
