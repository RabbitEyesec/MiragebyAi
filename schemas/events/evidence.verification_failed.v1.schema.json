{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirage.local/schemas/events/evidence.verification_failed.v1.schema.json",
  "title": "EvidenceVerificationFailedV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "case_id", "verification_id", "status", "expected_sha256", "reason"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "case_id": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "verification_id": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "status": {"enum": ["FAILED", "MISSING", "HASH_MISMATCH"]},
    "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "calculated_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 128},
    "error": {"type": ["string", "null"], "maxLength": 1024}
  }
}
