# Mirage dashboard — local (host, non-Docker) `npm run dev` environment.
#
# Copy to .env.local (gitignored, auto-loaded by Next.js). The Docker Compose
# path (infra/compose/docker-compose.yml, mirage-dashboard service) sets its
# own equivalents directly and does not read this file.
#
# 3001, not 3000: `npm run dev` pins -p 3001 (see package.json) so a taken
# port fails loudly instead of silently shifting ports (see
# scripts/dev-auth-doctor and ARCHITECTURE_DECISIONS.md). This must match the
# Keycloak client's redirect URIs/web origins/root URL/base URL — run
# scripts/bootstrap-keycloak-realm after changing it.

MIRAGE_DASHBOARD_URL=http://localhost:3001
MIRAGE_OIDC_ISSUER_URL=http://localhost:8081/realms/mirage
MIRAGE_OIDC_INTERNAL_ISSUER_URL=http://localhost:8081/realms/mirage
MIRAGE_OIDC_CLIENT_ID=mirage-dashboard
MIRAGE_API_URL=http://localhost:18000
MIRAGE_SESSION_SECRET=mirage_dev_local_only_dashboard_session_secret_32ch
