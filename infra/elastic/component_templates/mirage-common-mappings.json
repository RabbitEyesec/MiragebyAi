{
  "template": {
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "event_id": { "type": "keyword" },
        "event_type": { "type": "keyword" },
        "schema_version": { "type": "keyword" },
        "event_time": { "type": "date", "format": "strict_date_optional_time_nanos" },
        "ingest_time": { "type": "date", "format": "strict_date_optional_time_nanos" },
        "case_id": { "type": "keyword" },
        "session_id": { "type": "keyword" },
        "source_id": { "type": "keyword" },
        "sequence": { "type": "long" },
        "actor_type": { "type": "keyword" },
        "integrity": {
          "properties": {
            "sha256": { "type": "keyword" }
          }
        },
        "classification": { "type": "keyword" },
        "payload": {
          "type": "object",
          "dynamic": "true"
        }
      }
    }
  },
  "_meta": {
    "description": "Common envelope fields shared by every Mirage telemetry data stream (spec Appendix C). 'payload' is intentionally dynamic:true — event-type-specific fields, already validated against /schemas at ingestion (Step 1), are not re-constrained here to avoid a second schema to keep in sync.",
    "owner": "mirage-agent-ingestion",
    "spec_reference": "Appendix C, Appendix E"
  }
}
